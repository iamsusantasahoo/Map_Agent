# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Cloud API key with "Places API (New)" enabled
GOOGLE_PLACES_API_KEY=

# Optional server-wide AI keys for message drafts. Team members can also set
# their own key inside Telegram with "/setkey gemini KEY" or "/setkey anthropic KEY".
# With no key anywhere, the bot uses built-in templates.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_MODEL=gemini-3.8-flash
# auto = use whichever key exists (anthropic first). Or: anthropic | gemini | template
DEFAULT_AI_PROVIDER=auto

# Optional. Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone who finds the bot.
ALLOWED_USER_IDS=

# Optional tuning. The number of businesses per search is asked from each
# user in the chat (/count), so it is not configured here.
RESULTS_PER_MESSAGE=5
CACHE_DAYS=30
DB_PATH=leads.db

# Your agency name, used inside message drafts
AGENCY_NAME=Genix
